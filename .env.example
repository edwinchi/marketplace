# Copy to .env.local (git-ignored) and fill in real values. Never commit actual secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard -> Products, created once a real account exists — see
# /my-account/ai-features (checkout-action.ts, lib/stripe.ts). Both must be set for the
# upgrade/top-up buttons there to appear at all; unset means they stay hidden, not broken.
STRIPE_SELLER_PRO_PRICE_ID=
STRIPE_TOPUP_PRICE_ID=

LOCKER_PARTNER_API_KEY=
LOCKER_PARTNER_WEBHOOK_SECRET=

# Powers the "let AI fill this in" photo assist on the post-ad wizard (analyze-photo-action.ts) —
# a key from openrouter.ai/keys (routed through OpenRouter rather than Anthropic directly, so this
# key can point at any vision-capable model OpenRouter offers). Without it, that feature degrades
# to an honest "not set up yet" message rather than faking a result; nothing else depends on it.
OPENROUTER_API_KEY=
# Optional — defaults to anthropic/claude-sonnet-4.5 if unset. Override without a redeploy if that
# slug ever changes; see openrouter.ai/models for current options.
OPENROUTER_MODEL=

NEXT_PUBLIC_MAPBOX_TOKEN=

# Powers the France/Belgium/Ireland plate lookup (lib/regcheck.ts) — a free account at
# regcheck.org.uk gives one username shared across all its country-specific SOAP methods (10 free
# lookups, then £0.15 each). Without it, those countries stay marked unavailable in the UI.
REGCHECK_USERNAME=

RESEND_API_KEY=

SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
