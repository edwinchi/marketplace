# dependencies
node_modules/
apps/*/node_modules/

# Next.js build output — root-level .next/ was git-tracked deliberately for the old Plesk
# git-panel deploy mechanism (see agents.md §11); that path is superseded by FTP and isn't used by
# Vercel, which builds fresh from source, so it's untracked here too.
/.next/
apps/*/.next/
apps/*/out/

# env files with real secrets — .env.example is the only env file that belongs in git
.env
.env.local
.env*.local
apps/*/.env
apps/*/.env.local
apps/*/.env*.local

# Supabase local dev
supabase/.temp/
supabase/.branches/

# logs / OS / editor cruft
*.log
.DS_Store
Thumbs.db

# ops/watchdog.py's FTP credentials — same rule as .env*, never committed
ops/*.local.json
